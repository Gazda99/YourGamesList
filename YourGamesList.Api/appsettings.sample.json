{
  "IgdbHttpClient": {
    "BaseAddress": "https://api.igdb.com/v4"
  },
  "LibSodiumPasswordHashing": {
    "OpsLimit": 2,
    "MemoryLimit": 19922944
  },
  "RequestValidator": {
    "Email": {
      "MaximumEmailLength": 256
    },
    "Lists": {
      "MinimumListNameLength": 3,
      "MaximumListNameLength": 500,
      "MaximumGameListEntryDescriptionLength": 500
    },
    "Username": {
      "AllowedCharactersRegex": "^[a-zA-Z0-9_-]+$",
      "MinimumUsernameLength": 4,
      "MaximumUsernameLength": 64
    },
    "Password": {
      "MinimumPasswordLength": 8,
      "MaximumPasswordLength": 128
    },
    "DateOfBirth": {
      "MinimumAge": 12,
      "MaximumAge": 150
    }
  },
  "TelemetryConfiguration": {
    "ApiSecret": "<REPLACE-ME>",
    "OtlpExporterTracesEndpoint": "<REPLACE-ME>",
    "OtlpExporterMetricsEndpoint": "<REPLACE-ME>",
    "ServiceName": "ygl-api",
    "TracesStreamName": "ygl_api"
  },
  "TokenAuth": {
    "Audience": "http://yourgameslist.com",
    "Issuer": "http://yourgameslist.com",
    "JwtSecret": "<REPLACE_ME>",
    "ExpirationInMinutes": "120"
  },
  "TwitchAuth": {
    "ClientId": "<REPLACE_ME>",
    "ClientSecret": "<REPLACE_ME>"
  },
  "TwitchAuthHttpClient": {
    "BaseAddress": "https://id.twitch.tv"
  },
  "UserManagerService": {
    "EnableEmailConfirmation": true,
    "DefaultEmailVerificationExpiryInMinutes": 120,
    "DefaultPendingUserExpiryInMinutes": 1440
  },
  "VerificationEmailSender": {
    "YglUrl": "<REPLACE_ME>/users/auth/confirmEmail",
    "Password": "<REPLACE_ME>",
    "Address": "<REPLACE_ME>",
    "Username": "<REPLACE_ME>",
    "SmtpHost": "<REPLACE_ME>",
    "SmtpPort": "<REPLACE_ME>"
  },
  "YourGamesListDatabase": {
    "ConnectionString": "Data Source=../database/v1/ygl_db.db",
    "MigrationAssembly": "YourGamesList.Database"
  }
}